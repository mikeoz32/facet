+private def record_macro_fixture(macro_body, expected, argument_names, arguments, flags, file, line, *, contextual_program)
+  path = ENV["FACET_MACRO_CAPTURE"]?
+  return unless path
+
+  File.open(path, "a") do |io|
+    JSON.build(io) do |json|
+      json.object do
+        json.field "source_file", file
+        json.field "line", line
+        json.field "body", macro_body
+        json.field "expected", expected
+        json.field "flags", flags
+        json.field "contextual_program", contextual_program
+        json.field "arguments" do
+          json.array do
+            arguments.each_with_index do |node, index|
+              json.object do
+                json.field "name", argument_names[index]
+                json.field "source", node.to_s
+                json.field "kind", node.class.name
+                json.field "filename", node.location.try { |location| location.filename.to_s }
+                json.field "line_number", node.location.try(&.line_number)
+                json.field "column_number", node.location.try(&.column_number)
+                json.field "end_filename", node.end_location.try { |location| location.filename.to_s }
+                json.field "end_line_number", node.end_location.try(&.line_number)
+                json.field "end_column_number", node.end_location.try(&.column_number)
+                json.field "doc", node.doc
+                if captured_name = facet_macro_capture_name(node)
+                  json.field "name_source", captured_name.source
+                  json.field "name_kind", captured_name.kind
+                  json.field "name_without_generic_args_source", captured_name.without_generic_args_source
+                end
+              end
+            end
+          end
+        end
+      end
+    end
+    io << '\n'
+  end
+end
+
+record FacetMacroCapturedName,
+  source : String,
+  kind : String,
+  without_generic_args_source : String? = nil
+
+private def facet_macro_capture_name(node : Crystal::ASTNode) : FacetMacroCapturedName?
+  case node
+  when Crystal::Primitive
+    value = node.name
+    source = value.matches?(/\A[a-zA-Z_][a-zA-Z0-9_]*[?!]?\z/) ? ":#{value}" : ":#{value.inspect}"
+    FacetMacroCapturedName.new(source, "symbol")
+  when Crystal::RespondsTo
+    FacetMacroCapturedName.new(node.name.inspect, "string")
+  when Crystal::ClassDef
+    facet_macro_capture_generic_name(node.name, node.type_vars, node.splat_index)
+  when Crystal::ModuleDef
+    facet_macro_capture_generic_name(node.name, node.type_vars, node.splat_index)
+  when Crystal::Annotation
+    FacetMacroCapturedName.new(node.path.to_s, "identifier")
+  when Crystal::Include, Crystal::Extend, Crystal::Generic
+    FacetMacroCapturedName.new(node.name.to_s, "identifier")
+  when Crystal::AnnotationDef, Crystal::EnumDef, Crystal::LibDef, Crystal::Alias
+    FacetMacroCapturedName.new(node.name.to_s, "identifier")
+  when Crystal::Call, Crystal::Arg, Crystal::Def, Crystal::Macro,
+       Crystal::MacroVar, Crystal::MetaMacroVar, Crystal::ProcPointer,
+       Crystal::InstanceVar, Crystal::ReadInstanceVar, Crystal::ClassVar,
+       Crystal::Global, Crystal::CStructOrUnionDef, Crystal::FunDef,
+       Crystal::TypeDef, Crystal::ExternalVar
+    FacetMacroCapturedName.new(node.name.to_s, "identifier")
+  end
+end
+
+private def facet_macro_capture_generic_name(
+  name : Crystal::Path,
+  type_vars : Array(String)?,
+  splat_index : Int32?,
+) : FacetMacroCapturedName
+  base = name.to_s
+  variables = type_vars || [] of String
+  source = if variables.empty?
+             base
+           else
+             rendered = variables.map_with_index do |variable, index|
+               index == splat_index ? "*#{variable}" : variable
+             end
+             "#{base}(#{rendered.join(", ")})"
+           end
+  FacetMacroCapturedName.new(source, "identifier", base)
+end
+
 def assert_macro_error(macro_body, message = nil, args = nil, *, flags = nil, file = __FILE__, line = __LINE__)
   assert_macro_error(macro_body, message, flags: flags, file: file, line: line) { args }
 end
