@@ -3,6 +3,7 @@
 Crystal::Config.path = "#{__DIR__}/../src"
 
 require "spec"
+require "json"
 
 require "compiler/requires"
 require "./support/syntax"
@@ -184,17 +185,310 @@ def assert_no_warning(code, *, file = __FILE__, line = __LINE__)
