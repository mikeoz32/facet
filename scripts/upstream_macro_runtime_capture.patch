+private def record_macro_fixture(macro_body, expected, argument_names, arguments, flags, file, line, *, contextual_program)
+  path = ENV["FACET_MACRO_CAPTURE"]?
+  return unless path
+
+  File.open(path, "a") do |io|
+    JSON.build(io) do |json|
+      json.object do
+        json.field "source_file", file
+        json.field "line", line
+        json.field "body", macro_body
+        json.field "expected", expected
+        json.field "flags", flags
+        json.field "contextual_program", contextual_program
+        json.field "arguments" do
+          json.array do
+            arguments.each_with_index do |node, index|
+              json.object do
+                json.field "name", argument_names[index]
+                json.field "source", node.to_s
+                json.field "kind", node.class.name
+                json.field "filename", node.location.try { |location| location.filename.to_s }
+                json.field "line_number", node.location.try(&.line_number)
+                json.field "column_number", node.location.try(&.column_number)
+                json.field "end_filename", node.end_location.try { |location| location.filename.to_s }
+                json.field "end_line_number", node.end_location.try(&.line_number)
+                json.field "end_column_number", node.end_location.try(&.column_number)
+                json.field "doc", node.doc
+                if captured_name = facet_macro_capture_name(node)
+                  json.field "name_source", captured_name.source
+                  json.field "name_kind", captured_name.kind
+                  json.field "name_without_generic_args_source", captured_name.without_generic_args_source
+                end
+                if structure = facet_macro_capture_structure(node)
+                  json.field "structure", structure
+                end
+              end
+            end
+          end
+        end
+      end
+    end
+    io << '\n'
+  end
+end
+
+record FacetMacroCapturedName,
+  source : String,
+  kind : String,
+  without_generic_args_source : String? = nil
+
+class FacetMacroCapturedNode
+  include JSON::Serializable
+
+  getter source : String
+  getter kind : String
+  getter fields : Hash(String, FacetMacroCapturedNode)
+  getter collections : Hash(String, Array(FacetMacroCapturedNode))
+  getter booleans : Hash(String, Bool)
+  getter nil_fields : Array(String)
+
+  def initialize(
+    @source : String,
+    @kind : String,
+    @fields = {} of String => FacetMacroCapturedNode,
+    @collections = {} of String => Array(FacetMacroCapturedNode),
+    @booleans = {} of String => Bool,
+    @nil_fields = [] of String,
+  )
+  end
+end
+
+private def facet_macro_capture_structure(node : Crystal::ASTNode) : FacetMacroCapturedNode?
+  case node
+  when Crystal::Call
+    fields = {
+      "receiver"  => facet_macro_capture_node(node.obj),
+      "block"     => facet_macro_capture_node(node.block),
+      "block_arg" => facet_macro_capture_node(node.block_arg),
+    }
+    collections = {
+      "args"       => node.args.map { |argument| facet_macro_capture_node(argument) },
+      "named_args" => (node.named_args || [] of Crystal::NamedArgument).map { |argument| facet_macro_capture_named_argument(argument) },
+    }
+    FacetMacroCapturedNode.new(
+      node.to_s,
+      node.class.name,
+      fields,
+      collections,
+      {"global?" => node.global?}
+    )
+  when Crystal::Case
+    fields = {
+      "cond" => facet_macro_capture_node(node.cond),
+      "else" => facet_macro_capture_node(node.else),
+    }
+    collections = {
+      "whens" => node.whens.map { |item| facet_macro_capture_when(item) },
+    }
+    FacetMacroCapturedNode.new(node.to_s, node.class.name, fields, collections, {"exhaustive?" => node.exhaustive?})
+  when Crystal::Select
+    fields = {"else" => facet_macro_capture_node(node.else)}
+    collections = {
+      "whens" => node.whens.map { |item| facet_macro_capture_when(item) },
+    }
+    FacetMacroCapturedNode.new(node.to_s, node.class.name, fields, collections)
+  when Crystal::ExceptionHandler
+    fields = {
+      "body"   => facet_macro_capture_node(node.body),
+      "else"   => facet_macro_capture_node(node.else),
+      "ensure" => facet_macro_capture_node(node.ensure),
+    }
+    collections = {
+      "rescues" => (node.rescues || [] of Crystal::Rescue).map { |item| facet_macro_capture_rescue(item) },
+    }
+    FacetMacroCapturedNode.new(node.to_s, node.class.name, fields, collections)
+  when Crystal::Rescue
+    facet_macro_capture_rescue(node)
+  when Crystal::FunDef
+    facet_macro_capture_fun_def(node)
+  when Crystal::Macro
+    facet_macro_capture_macro(node)
+  when Crystal::Def
+    facet_macro_capture_def(node)
+  when Crystal::Arg
+    facet_macro_capture_arg(node)
+  end
+end
+
+private def facet_macro_capture_when(node : Crystal::When) : FacetMacroCapturedNode
+  fields = {"body" => facet_macro_capture_node(node.body)}
+  collections = {
+    "conds" => node.conds.map { |condition| facet_macro_capture_node(condition) },
+  }
+  FacetMacroCapturedNode.new(node.to_s, node.class.name, fields, collections, {"exhaustive?" => node.exhaustive?})
+end
+
+private def facet_macro_capture_rescue(node : Crystal::Rescue) : FacetMacroCapturedNode
+  fields = {
+    "body" => facet_macro_capture_node(node.body),
+    "name" => node.name ? FacetMacroCapturedNode.new(node.name.not_nil!, "identifier") : facet_macro_capture_node(nil),
+  }
+  collections = {} of String => Array(FacetMacroCapturedNode)
+  nil_fields = [] of String
+  if types = node.types
+    collections["types"] = types.map { |type| facet_macro_capture_node(type) }
+  else
+    nil_fields << "types"
+  end
+  FacetMacroCapturedNode.new(node.to_s, node.class.name, fields, collections, nil_fields: nil_fields)
+end
+
+private def facet_macro_capture_def(node : Crystal::Def) : FacetMacroCapturedNode
+  fields = {
+    "body"         => facet_macro_capture_node(node.body),
+    "double_splat" => facet_macro_capture_node(node.double_splat),
+    "block_arg"    => facet_macro_capture_node(node.block_arg),
+    "return_type"  => facet_macro_capture_node(node.return_type),
+    "receiver"     => facet_macro_capture_node(node.receiver),
+    "visibility"   => facet_macro_capture_visibility(node.visibility),
+  }
+  nil_fields = [] of String
+  if splat_index = node.splat_index
+    fields["splat_index"] = FacetMacroCapturedNode.new(splat_index.to_s, "Crystal::NumberLiteral")
+  else
+    nil_fields << "splat_index"
+  end
+  collections = {
+    "args"      => node.args.map { |argument| facet_macro_capture_arg(argument) },
+    "free_vars" => (node.free_vars || [] of String).map { |name| FacetMacroCapturedNode.new(name, "Crystal::MacroId") },
+  }
+  booleans = {
+    "accepts_block?" => !node.block_arity.nil?,
+    "abstract?"      => node.abstract?,
+  }
+  FacetMacroCapturedNode.new(node.to_s, node.class.name, fields, collections, booleans, nil_fields)
+end
+
+private def facet_macro_capture_macro(node : Crystal::Macro) : FacetMacroCapturedNode
+  fields = {
+    "body"         => facet_macro_capture_node(node.body),
+    "double_splat" => facet_macro_capture_node(node.double_splat),
+    "block_arg"    => facet_macro_capture_node(node.block_arg),
+    "visibility"   => facet_macro_capture_visibility(node.visibility),
+  }
+  nil_fields = [] of String
+  if splat_index = node.splat_index
+    fields["splat_index"] = FacetMacroCapturedNode.new(splat_index.to_s, "Crystal::NumberLiteral")
+  else
+    nil_fields << "splat_index"
+  end
+  collections = {
+    "args" => node.args.map { |argument| facet_macro_capture_arg(argument) },
+  }
+  FacetMacroCapturedNode.new(node.to_s, node.class.name, fields, collections, nil_fields: nil_fields)
+end
+
+private def facet_macro_capture_fun_def(node : Crystal::FunDef) : FacetMacroCapturedNode
+  real_name = node.real_name == node.name ? facet_macro_capture_node(nil) : FacetMacroCapturedNode.new(node.real_name.inspect, "Crystal::StringLiteral")
+  fields = {
+    "real_name"   => real_name,
+    "return_type" => facet_macro_capture_node(node.return_type),
+    "body"        => facet_macro_capture_node(node.body),
+  }
+  collections = {
+    "args" => node.args.map { |argument| facet_macro_capture_arg(argument) },
+  }
+  booleans = {
+    "variadic?" => node.varargs?,
+    "has_body?" => !node.body.nil?,
+  }
+  FacetMacroCapturedNode.new(node.to_s, node.class.name, fields, collections, booleans)
+end
+
+private def facet_macro_capture_arg(node : Crystal::Arg) : FacetMacroCapturedNode
+  fields = {
+    "name"          => FacetMacroCapturedNode.new(node.external_name, "identifier"),
+    "internal_name" => FacetMacroCapturedNode.new(node.name, "identifier"),
+    "default_value" => facet_macro_capture_node(node.default_value),
+    "restriction"   => facet_macro_capture_node(node.restriction),
+  }
+  FacetMacroCapturedNode.new(node.to_s, node.class.name, fields)
+end
+
+private def facet_macro_capture_visibility(visibility : Crystal::Visibility) : FacetMacroCapturedNode
+  FacetMacroCapturedNode.new(":#{visibility.to_s.downcase}", "Crystal::SymbolLiteral")
+end
+
+private def facet_macro_capture_node(node : Crystal::ASTNode?) : FacetMacroCapturedNode
+  return FacetMacroCapturedNode.new("", "Crystal::Nop") unless node
+  FacetMacroCapturedNode.new(node.to_s, node.class.name)
+end
+
+private def facet_macro_capture_named_argument(node : Crystal::NamedArgument) : FacetMacroCapturedNode
+  fields = {
+    "name"  => FacetMacroCapturedNode.new(node.name, "identifier"),
+    "value" => facet_macro_capture_node(node.value),
+  }
+  FacetMacroCapturedNode.new(node.to_s, node.class.name, fields)
+end
+
+private def facet_macro_capture_name(node : Crystal::ASTNode) : FacetMacroCapturedName?
+  case node
+  when Crystal::Primitive
+    value = node.name
+    source = value.matches?(/\A[a-zA-Z_][a-zA-Z0-9_]*[?!]?\z/) ? ":#{value}" : ":#{value.inspect}"
+    FacetMacroCapturedName.new(source, "symbol")
+  when Crystal::RespondsTo
+    FacetMacroCapturedName.new(node.name.inspect, "string")
+  when Crystal::ClassDef
+    facet_macro_capture_generic_name(node.name, node.type_vars, node.splat_index)
+  when Crystal::ModuleDef
+    facet_macro_capture_generic_name(node.name, node.type_vars, node.splat_index)
+  when Crystal::Annotation
+    FacetMacroCapturedName.new(node.path.to_s, "identifier")
+  when Crystal::Arg
+    FacetMacroCapturedName.new(node.external_name, "identifier")
+  when Crystal::Include, Crystal::Extend, Crystal::Generic
+    FacetMacroCapturedName.new(node.name.to_s, "identifier")
+  when Crystal::AnnotationDef, Crystal::EnumDef, Crystal::LibDef, Crystal::Alias
+    FacetMacroCapturedName.new(node.name.to_s, "identifier")
+  when Crystal::Call, Crystal::Def, Crystal::Macro,
+       Crystal::MacroVar, Crystal::MetaMacroVar, Crystal::ProcPointer,
+       Crystal::InstanceVar, Crystal::ReadInstanceVar, Crystal::ClassVar,
+       Crystal::Global, Crystal::CStructOrUnionDef, Crystal::FunDef,
+       Crystal::TypeDef, Crystal::ExternalVar
+    FacetMacroCapturedName.new(node.name.to_s, "identifier")
+  end
+end
+
+private def facet_macro_capture_generic_name(
+  name : Crystal::Path,
+  type_vars : Array(String)?,
+  splat_index : Int32?,
+) : FacetMacroCapturedName
+  base = name.to_s
+  variables = type_vars || [] of String
+  source = if variables.empty?
+             base
+           else
+             rendered = variables.map_with_index do |variable, index|
+               index == splat_index ? "*#{variable}" : variable
+             end
+             "#{base}(#{rendered.join(", ")})"
+           end
+  FacetMacroCapturedName.new(source, "identifier", base)
+end
+
 def assert_macro_error(macro_body, message = nil, args = nil, *, flags = nil, file = __FILE__, line = __LINE__)
   assert_macro_error(macro_body, message, flags: flags, file: file, line: line) { args }
 end
