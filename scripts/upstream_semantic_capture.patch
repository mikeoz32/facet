+private def record_facet_semantic_contract(
+  kind : String,
+  source : String,
+  file : String,
+  line : Int32,
+  inject_primitives : Bool = false,
+  flags : String? = nil,
+  expected_type : String? = nil,
+  actual_type : String? = nil,
+  expected_error : String? = nil,
+  actual_error : Crystal::TypeException? = nil,
+)
+  path = ENV["FACET_SEMANTIC_CAPTURE"]?
+  return unless path
+  File.open(path, "a") do |io|
+    JSON.build(io) do |json|
+      json.object do
+        json.field "kind", kind
+        json.field "source", source
+        json.field "suite", File.basename(file)
+        json.field "file", file
+        json.field "line", line
+        json.field "inject_primitives", inject_primitives
+        json.field "flags", flags
+        json.field "expected_type", expected_type
+        json.field "actual_type", actual_type
+        json.field "expected_error", expected_error
+        json.field "actual_error", actual_error.try(&.deepest_error_message).try(&.to_s)
+        json.field "error_line", actual_error.try(&.line_number)
+        json.field "error_column", actual_error.try(&.column_number)
+        json.field "error_size", actual_error.try(&.size)
+      end
+    end
+    io << '\n'
+  end
+end
+
+private def semantic_contract_type(node : Crystal::ASTNode) : String
+  target = node.is_a?(Crystal::Expressions) ? node.last : node
+  target.type.to_s
+end
